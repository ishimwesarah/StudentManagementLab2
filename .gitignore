# Maven build output - never commit compiled artifacts
target/

# IDE-specific files
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# OS-specific files
.DS_Store
Thumbs.db

# Logs generated at runtime
*.log

# Files generated by the app's own features (reports/imports are
# user data, not source code - the directories themselves are kept
# via .gitkeep, but their generated contents are not)
reports/*.txt
imports/*.csv
!reports/.gitkeep
!imports/.gitkeep
